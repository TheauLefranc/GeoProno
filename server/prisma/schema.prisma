generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum BetStatus {
  PROPOSED // waiting for community votes
  OPEN // accepting wagers until closesAt
  SETTLED // result entered, payouts done
  CANCELLED // stakes refunded
  REJECTED // refused by a moderator before opening
}

enum WagerStatus {
  PENDING
  WON
  LOST
  REFUNDED
}

enum TxType {
  SIGNUP_BONUS
  DAILY_REFILL
  BET_STAKE
  BET_PAYOUT
  BET_REFUND
  ADMIN_ADJUST
}

enum GroupRole {
  OWNER
  MEMBER
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  username          String   @unique
  passwordHash      String
  role              Role     @default(USER)
  balance           Int      @default(0)
  /// Bumped on password reset/change: sessions signed with an older value are rejected.
  sessionVersion    Int      @default(0)
  /// Sport managers: category ids this user may run matches for (main ids like
  /// "SPORT" cover all their subcategories). Admins/moderators manage everything.
  managedCategories String[] @default([])
  createdAt         DateTime @default(now())

  wagers                Wager[]
  votes                 BetVote[]
  proposedBets          Bet[]           @relation("BetCreator")
  transactions          Transaction[]
  memberships           GroupMember[]
  ownedGroups           Group[]         @relation("GroupOwner")
  matches               Match[]         @relation("MatchCreator")
  brackets              Bracket[]       @relation("BracketCreator")
  bracketEntries        BracketEntry[]
  passwordResets        PasswordReset[] @relation("ResetTarget")
  createdPasswordResets PasswordReset[] @relation("ResetCreator")
}

/// One-time password reset link generated by an admin (no email involved).
/// Only the SHA-256 of the token is stored; the link itself is shown once.
model PasswordReset {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId      String
  user        User   @relation("ResetTarget", fields: [userId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User   @relation("ResetCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Bet {
  id              String    @id @default(cuid())
  title           String
  description     String?
  category        String
  status          BetStatus @default(PROPOSED)
  oddsEnabled     Boolean   @default(false)
  closesAt        DateTime
  votesRequired   Int
  createdAt       DateTime  @default(now())
  openedAt        DateTime?
  settledAt       DateTime?
  winningOptionId String?
  /// Wagers are refused before this date (match bets open N days before kick-off).
  opensAt         DateTime?

  creatorId String
  creator   User    @relation("BetCreator", fields: [creatorId], references: [id])
  groupId   String?
  group     Group?  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  options      BetOption[]
  votes        BetVote[]
  wagers       Wager[]
  transactions Transaction[]
  match        Match?
  /// Set on the bet of a whole-bracket prediction.
  bracket      Bracket?      @relation("BracketTreeBet")

  /// Bet on one match of a bracket, opened once both entrants are known and
  /// settled by that match result. Option position 0/1 = bracketSlots[0]/[1].
  matchBracketId    String?
  matchBracket      Bracket? @relation("BracketMatchBets", fields: [matchBracketId], references: [id], onDelete: Cascade)
  bracketMatchIndex Int?
  bracketSlots      Int[]    @default([])

  @@index([status, closesAt])
  @@index([groupId])
  @@index([matchBracketId])
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
  CANCELLED
}

/// A fixture entered in advance by staff: shown in the schedule, scored live,
/// and (optionally) carrying the bet that opens N days before kick-off.
model Match {
  id        String      @id @default(cuid())
  category  String
  homeName  String
  awayName  String
  location  String?
  startsAt  DateTime
  status    MatchStatus @default(SCHEDULED)
  homeScore Int         @default(0)
  awayScore Int         @default(0)
  /// Free live detail: "2e mi-temps", "Set 3", "Prolongations"…
  liveNote  String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  createdById String
  createdBy   User   @relation("MatchCreator", fields: [createdById], references: [id])

  betId        String? @unique
  bet          Bet?    @relation(fields: [betId], references: [id], onDelete: SetNull)
  homeOptionId String?
  drawOptionId String?
  awayOptionId String?

  @@index([startsAt])
  @@index([status])
}

/// Knockout bracket ("phases finales"): staff place the participants, players
/// predict the whole tree before the lock. Money goes through the linked Bet
/// (one option, one wager per entry), so history, refunds and the leaderboard
/// work unchanged. Structure and maths: services/bracketLogic.ts.
model Bracket {
  id           String   @id @default(cuid())
  title        String
  category     String
  /// Number of first-round slots (4, 8, 16 or 32).
  size         Int
  /// First-round slots in bracket order; "" is a bye.
  participants String[]
  /// Winner (slot index) of each match in bracket order, null until played.
  outcomes     Json
  /// Optional score text per match ("3-1", "2 sets à 1"…).
  scores       Json
  /// Optional kick-off (ISO string) per match: its match bet closes then.
  times        Json     @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdById String
  createdBy   User   @relation("BracketCreator", fields: [createdById], references: [id])
  betId       String @unique
  bet         Bet    @relation("BracketTreeBet", fields: [betId], references: [id], onDelete: Cascade)

  entries   BracketEntry[]
  matchBets Bet[]          @relation("BracketMatchBets")

  @@index([createdAt])
}

/// One player's prediction of a whole bracket, paid through its wager.
model BracketEntry {
  id        String   @id @default(cuid())
  /// Predicted winner (slot index) of every match, same order as Bracket.outcomes.
  picks     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bracketId String
  bracket   Bracket @relation(fields: [bracketId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  wagerId   String  @unique
  wager     Wager   @relation(fields: [wagerId], references: [id], onDelete: Cascade)

  @@unique([bracketId, userId])
}

model BetOption {
  id       String @id @default(cuid())
  label    String
  position Int
  /// Decimal odds x100 (185 = 1.85). Null when the bet runs as a pool.
  oddsX100 Int?

  betId  String
  bet    Bet     @relation(fields: [betId], references: [id], onDelete: Cascade)
  wagers Wager[]
}

model BetVote {
  betId     String
  userId    String
  createdAt DateTime @default(now())
  bet       Bet      @relation(fields: [betId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([betId, userId])
}

model Wager {
  id        String      @id @default(cuid())
  amount    Int
  /// Odds locked at the time the wager was placed (fixed-odds bets only).
  oddsX100  Int?
  payout    Int?
  status    WagerStatus @default(PENDING)
  createdAt DateTime    @default(now())

  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  betId        String
  bet          Bet           @relation(fields: [betId], references: [id], onDelete: Cascade)
  optionId     String
  option       BetOption     @relation(fields: [optionId], references: [id], onDelete: Cascade)
  bracketEntry BracketEntry?

  @@index([userId])
  @@index([betId])
}

model Transaction {
  id           String   @id @default(cuid())
  type         TxType
  amount       Int
  balanceAfter Int
  note         String?
  createdAt    DateTime @default(now())

  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  betId  String?
  bet    Bet?    @relation(fields: [betId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model Group {
  id         String   @id @default(cuid())
  name       String
  inviteCode String   @unique
  createdAt  DateTime @default(now())

  ownerId String
  owner   User          @relation("GroupOwner", fields: [ownerId], references: [id])
  members GroupMember[]
  bets    Bet[]
}

model GroupMember {
  groupId  String
  userId   String
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())
  group    Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
}

/// Single row (id = 1) holding settings editable by admins.
model AppSettings {
  id                 Int     @id @default(1)
  refillThreshold    Int     @default(100)
  refillHour         Int     @default(7)
  signupBonus        Int     @default(1000)
  votesRequired      Int     @default(10)
  oddsFeatureEnabled Boolean @default(true)
  minStake           Int     @default(1)
  maxStake           Int     @default(5000)
  /// Match bets open this many days before kick-off.
  betOpenDays        Int     @default(5)
  lastRefillDate     String?
}
